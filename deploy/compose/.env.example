# Synthetic development-only values. Copy this file to deploy/compose/.env locally;
# never reuse these values outside a disposable development environment.
OPENLIMS_POSTGRES_DATABASE=openlims_development
OPENLIMS_POSTGRES_USER=openlims_dev
OPENLIMS_POSTGRES_PASSWORD=replace-with-a-local-synthetic-password
OPENLIMS_POSTGRES_PORT=5432
OPENLIMS_KEYCLOAK_ADMIN_USER=local-admin
OPENLIMS_KEYCLOAK_ADMIN_PASSWORD=replace-with-a-local-synthetic-password
OPENLIMS_KEYCLOAK_PORT=8080
OPENLIMS_MINIO_ROOT_USER=local-minio-admin
OPENLIMS_MINIO_ROOT_PASSWORD=replace-with-a-local-synthetic-password
OPENLIMS_MINIO_PORT=9000
OPENLIMS_MINIO_CONSOLE_PORT=9001
OPENLIMS_MINIO_BUCKET=openlims-development-development-group
