# This file contains only synthetic configuration. It is intentionally not a
# production template and binds one disposable Organization Group per stack.
Platform__OrganizationGroupId=development-group
Platform__EnvironmentName=Development
Platform__PostgresConnectionString=Host=localhost;Port=5432;Database=openlims_development;Username=openlims_dev;Password=replace-with-the-local-compose-password
Platform__PostgresCommandTimeoutSeconds=10
Platform__OidcAuthority=http://localhost:8080/realms/openlims-development
Platform__OidcAudience=openlims-api
Platform__OidcMetadataTimeoutSeconds=5
Platform__AllowInsecureDevelopmentOidc=true
Platform__ObjectStorageEndpoint=http://localhost:9000
Platform__ObjectStorageBucket=openlims-development-development-group
Platform__ObjectStorageAccessKey=local-minio-admin
Platform__ObjectStorageSecretKey=replace-with-the-local-compose-password
Platform__ObjectStorageProbeTimeoutSeconds=5
Platform__AllowInsecureDevelopmentObjectStorage=true
Platform__OtlpEndpointRef=disabled-in-development
Platform__DependencyProbeTimeoutSeconds=15
