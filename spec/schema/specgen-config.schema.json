{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlims.local/schema/specgen-config.schema.json",
  "title": "OpenLIMS specgen configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "spec_roots",
    "source_documents",
    "source_baseline_path",
    "generated_root",
    "lock_path",
    "governance"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "project": {"type": "string", "minLength": 1},
    "spec_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/relativePath"}
    },
    "source_documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "format"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"},
          "path": {"$ref": "#/$defs/relativePath"},
          "format": {"enum": ["openlims-prd-markdown"]}
        }
      }
    },
    "source_baseline_path": {"$ref": "#/$defs/relativePath"},
    "generated_root": {"$ref": "#/$defs/relativePath"},
    "lock_path": {"$ref": "#/$defs/relativePath"},
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unknown_applicability_policy",
        "runtime_version_resolution",
        "generated_file_policy",
        "handwritten_code_policy",
        "historical_migration_policy",
        "evidence_policy"
      ],
      "properties": {
        "unknown_applicability_policy": {"const": "block"},
        "runtime_version_resolution": {"const": "pinned_only"},
        "generated_file_policy": {"const": "replace"},
        "handwritten_code_policy": {"const": "never_overwrite"},
        "historical_migration_policy": {"const": "append_only"},
        "evidence_policy": {"const": "immutable"}
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "(^[A-Za-z]:)|(^[/\\\\])|(^|[/\\\\])\\.\\.([/\\\\]|$)"}
    }
  }
}
